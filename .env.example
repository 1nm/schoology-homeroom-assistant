# --- Schoology account (required) ---
SCHOOLOGY_EMAIL=parent@example.com
SCHOOLOGY_PASSWORD=your_password
SCHOOLOGY_SUBDOMAIN=school_subdomain

# --- The course to watch ---
# Set one of these so a normal run never has to drive the browser to find the
# course. HOMEROOM_COURSE_URL is also the "view on Schoology" link in the mail.
HOMEROOM_COURSE_URL=https://school_subdomain.schoology.com/course/1234567890
#SCHOOLOGY_COURSE_ID=1234567890
HOMEROOM_CLASS=G3A
# Only used when no course id is known and the browser has to look one up.
#HOMEROOM_COURSE_NAME=Homeroom

# --- Mail (required) ---
SUMMARY_SENDER_EMAIL=you@gmail.com
GOOGLE_APP_PASSWORD=your_google_app_password
SUMMARY_RECEIVER_EMAIL=recipient@example.com
BCC_EMAILS=parent1@example.com,parent2@example.com

# --- LLM: Claude ---
# Summaries, translations and the Slack bot all run `claude -p` (the Claude Code
# CLI, installed on this machine) on a Claude subscription. Get a long-lived token
# with `claude setup-token`; without it the machine's `claude login` is used.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#LLM_PROVIDER=claude              # claude | openai (openai needs OPENAI_API_KEY)
#SUMMARY_MODEL=opus               # defaults: opus / sonnet for claude, gpt-5.4 / gpt-4o for openai
#TRANSLATION_MODEL=sonnet
#TRANSLATION_LANGUAGES=Japanese,Chinese
#CLAUDE_BIN=/home/you/.local/bin/claude   # only if claude is not on PATH or in ~/.local/bin
#OPENAI_API_KEY=sk-...

# --- Semantic search ---
# qwen3: Qwen3-Embedding-0.6B run locally (downloaded once into .models/, ~600 MB).
#EMBEDDING_BACKEND=qwen3          # qwen3 | openai
#EMBED_THREADS=3                  # CPU threads for the embedding model

# --- Behaviour (all optional) ---
#DATA_DIR=.                       # where state, cookies and attachments live
#STATE_FILE=.sadc.conf
#HEADLESS=true
#SELENIUM_TIMEOUT=30
#HTTP_TIMEOUT=30
#MAX_PDF_MB=20                    # larger PDFs are attached but not summarised
#MAX_ATTACHMENT_MB=50             # larger downloads are skipped entirely
#MAX_EMAIL_ATTACHMENT_MB=15       # per-mail attachment budget (Gmail caps at 25)
#ERROR_NOTIFY_INTERVAL_HOURS=6    # how often to repeat an identical failure mail

# --- Materials mirror (Schoology REST API) ---
# Get a key at https://<subdomain>.schoology.com/api. A parent key can read course
# materials but not the Edge feed, so posts still come from the scraped feed.
SCHOOLOGY_API_CONSUMER_KEY=
SCHOOLOGY_API_CONSUMER_SECRET=
#SCHOOLOGY_CHILD_UID=            # discovered from /parent/home when unset
#MATERIALS_SKIP_FOLDERS=Photos   # comma separated folder names to leave alone
#MAX_MATERIAL_MB=50              # larger files are listed but not downloaded

# --- Class photo albums ---
#SYNC_ALBUMS=false               # several GB; off unless you ask for it
#ALBUM_ORIGINALS=true            # false stores the 600x600 thumbnail instead
#MAX_ALBUM_MB=50                 # album videos run to 300-450 MB each

# --- Slack (optional) ---
# Mirror each new post and materials change into one channel, mentioning people.
#SLACK_BOT_TOKEN=xoxb-...
#SLACK_CHANNEL=C0123456789
#SLACK_MENTIONS=U0123456789,U0987654321

# --- Faces (optional) ---
# Learn a child once (python app/faces.py --data-dir <data> learn <name> "Album:3,7"); from
# then on every album sync looks for them in the new photos and posts a sheet to Slack.
#FACE_THRESHOLD=0.45              # cosine similarity; lower finds more, with more mistakes
#FACE_FRAME_BELOW=0.5            # face height / tallest face in the photo; below this the photo is shown reframed around the child
#FACE_MIN_PROMINENCE=0           # same ratio, below which a photo is not reported at all (0 = never drop)
#FACE_MIN_SIZE=0                 # face height / image short edge; 0 keeps group photos however small the faces
#FACE_THREADS=3                   # CPU threads for the detector

# --- MCP server (run.sh serve) ---
# The archive over HTTP on 127.0.0.1:8848; clients send "Authorization: Bearer <MCP_TOKEN>".
# Make one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_TOKEN=

# --- Slack bot (run.sh bot) ---
# Answers parents' @mentions, DMs and thread replies. SLACK_BOT_TOKEN above is shared;
# the app-level token (connections:write) is for Socket Mode. See slack/manifest.json.
#SLACK_APP_TOKEN=xapp-...
#BOT_NAME=Homeroom Bot
#SCHOOL_NAME=Example International School
TIMEZONE=Asia/Tokyo               # resolves "today" and "last week"
#BOT_MODEL=sonnet                 # or opus
#BOT_MAX_TURNS=8                  # tool calls per answer
#BOT_TIMEOUT=600                  # seconds per answer
#THREAD_HISTORY=20                # earlier thread messages sent along
#MCP_URL=http://127.0.0.1:8848/mcp
