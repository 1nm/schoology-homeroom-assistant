{
  "display_information": {
    "name": "Homeroom Bot",
    "description": "Answers questions about the class homeroom: posts, homework, materials and photos.",
    "background_color": "#2c5f8a"
  },
  "features": {
    "bot_user": {
      "display_name": "homeroom-bot",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "channels:history",
        "im:history",
        "im:read",
        "im:write",
        "users:read",
        "files:write",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
